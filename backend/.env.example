# Backend environment. Copy to .env and adjust as needed.
# All values are optional - the prototype runs with no configuration.

# Dataset. Defaults to backend/data/cpse_synthetic_cleaned.csv,
# falling back to cpse_synthetic_material_master.csv.
# NMAP_CSV_PATH=/absolute/path/to/cpse_synthetic_cleaned.csv

# SQLite location for mappings, reviews and audit events.
# NMAP_DB_PATH=./data/nmap.db

# Comma-separated CORS origins. Defaults to *.
# NMAP_CORS_ORIGINS=http://localhost:5173

# Optional sentence-transformers signal. Off by default so the prototype
# never blocks on a model download. Requires `pip install sentence-transformers`
# and a locally cached model.
# NMAP_ENABLE_EMBEDDINGS=false
# NMAP_EMBEDDING_MODEL=all-MiniLM-L6-v2
